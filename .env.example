# Copy to .env to override. Every value below is also the built-in default,
# so the stack runs with no .env at all.

# --- Infrastructure -------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
WORK_QUEUE=frames.work
DLQ_QUEUE=frames.dlq
# Videos hash to partitions; one active consumer per partition gives ordered
# delivery per video. Caps parallel videos -- raise with detector replicas.
# Both services must agree on this value.
FRAME_PARTITIONS=4
# End-to-end latency budget for a live deployment.
MAX_LATENCY_SEC=2.0

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- VideoAnalyzer --------------------------------------------------------
# Only paths inside VIDEO_ROOT may be analyzed (path-traversal guard).
VIDEO_ROOT=/data/videos
JPEG_QUALITY=85
# Bounded queue between the decode thread and the publishers. THIS is the
# backpressure knob: a full queue blocks decoding.
ANALYZER_QUEUE_SIZE=256
ANALYZER_PUBLISHERS=4
# Frame blobs self-expire, so a crashed pipeline leaves no garbage behind.
FRAME_BLOB_TTL_SEC=3600
# Job progress is checkpointed every N *confirmed* frames, not every frame.
CHECKPOINT_EVERY=50
# Fail the whole job only if more than this fraction of frames fail to decode.
MAX_FRAME_FAILURE_RATIO=0.05
# Each job holds a decode thread and a publisher pool, so admission is bounded.
MAX_CONCURRENT_JOBS=4

# --- StreamDetector -------------------------------------------------------
# Max unacked messages held by one detector = consumer-side backpressure.
DETECTOR_PREFETCH=32
# send_results_next_service() takes a List -> flush on size OR latency.
BATCH_MAX_SIZE=32
BATCH_MAX_LATENCY_MS=500
DETECTOR_EXECUTOR_WORKERS=4
# Idempotency guard against at-least-once redelivery.
DEDUP_TTL_SEC=3600
# Shed frames older than this instead of processing them. 0 disables it, which
# is right for archive processing of a file. For a live camera set it to
# MAX_LATENCY_SEC: a stale answer has little value, and processing it starves
# the frame that is still current, so a backlog compounds instead of draining.
MAX_FRAME_AGE_SEC=0
